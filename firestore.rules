rules_version = '2';

// =====================================================================
//  Aturan keamanan Firestore - Extra Course (project: extra-course-d02c2)
// ---------------------------------------------------------------------
//  Website ini fokus pada permainan. Data administratif (absensi,
//  pendaftaran lengkap) ada di spreadsheet, bukan di sini.
//
//  Prinsip:
//   - Admin (admin@extracourse.com) boleh membaca & mengubah semua data.
//   - Siswa hanya boleh melihat data MILIKNYA SENDIRI.
//   - Siswa baru wajib memakai kode kelas yang aktif.
//   - Koleksi lain yang tidak disebut di bawah otomatis DITOLAK
//     (termasuk data lama: studentAttendance, registrations, classes, teachers).
//
//  Jika email admin diganti, ubah juga isAdmin() di bawah DAN ADMIN_EMAIL
//  di file ec-common.js.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Fungsi bantu ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'admin@extracourse.com';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidLevel(level) {
      return level in ['SD', 'SMP', 'SMA', 'S1', 'S2', 'UMUM'];
    }

    // Hewan peliharaan: { species: 'kucing'|'kelinci'|'naga', name: 1-16 huruf }
    function isValidPet(pet) {
      return pet is map
        && pet.keys().hasOnly(['species', 'name'])
        && pet.species in ['kucing', 'kelinci', 'naga']
        && pet.name is string
        && pet.name.size() > 0
        && pet.name.size() <= 16;
    }

    // Kode kelas ada, aktif, dan jenjangnya sama dengan yang dipakai siswa.
    function isActiveCodeFor(code, level) {
      let path = /databases/$(database)/documents/classCodes/$(code);
      return code is string
        && exists(path)
        && get(path).data.active == true
        && get(path).data.level == level;
    }

    // ---------- Profil siswa: users/{uid} ----------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Siswa mendaftar sendiri (index.html) dengan kode kelas yang aktif.
      // Akun tanpa email dibuat oleh admin (admin.html).
      allow create: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.keys().hasOnly(['name', 'role', 'email', 'level', 'classCode', 'loginType', 'createdAt'])
            && request.resource.data.role == 'Student'
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.loginType == 'email'
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 80
            && isValidLevel(request.resource.data.level)
            && isActiveCodeFor(request.resource.data.classCode, request.resource.data.level));

      // Siswa hanya boleh memperbarui waktu masuk terakhir, waktu terakhir
      // menekan "Mengerti" di pengumuman (announceSeenAt, harus waktu
      // sekarang), dan hewan peliharaannya (pet: jenis + nama).
      // Nama, jenjang, dan peran hanya bisa diubah admin.
      allow update: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lastLoginAt', 'announceSeenAt', 'pet'])
            && (!('announceSeenAt' in request.resource.data.diff(resource.data).affectedKeys())
                || request.resource.data.announceSeenAt == request.time)
            && (!('pet' in request.resource.data.diff(resource.data).affectedKeys())
                || isValidPet(request.resource.data.pet)));

      allow delete: if isAdmin();
    }

    // ---------- Kode kelas: classCodes/{code} ----------
    match /classCodes/{code} {
      // Siapa pun boleh mengecek SATU kode yang ia ketahui (untuk form daftar),
      // tetapi tidak boleh melihat daftar semua kode.
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ---------- Paket soal: questionPacks/{id} ----------
    // Bank soal dari guru. Siswa yang profilnya aktif boleh membaca paket
    // yang AKTIF (game menampilkan paket jenjangnya + "Semua jenjang").
    // Batas jenjang ditegakkan saat skor disimpan (lihat isValidPackScore):
    // paket jenjang lain tidak bisa menghasilkan poin.
    // Hanya admin yang bisa membuat, mengubah, atau menghapus paket.
    match /questionPacks/{packId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && resource.data.active == true);

      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.type in ['kosakata', 'verb', 'kalimat']
        && (request.resource.data.level == 'SEMUA' || isValidLevel(request.resource.data.level))
        && request.resource.data.active is bool
        // Level paket (opsional): 1-5
        && (!('tier' in request.resource.data)
            || (request.resource.data.tier is int && request.resource.data.tier >= 1 && request.resource.data.tier <= 5))
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 200
        && request.resource.data.itemCount == request.resource.data.items.size();

      allow delete: if isAdmin();
    }

    // ---------- Pengumuman: announcements/{id} ----------
    // Ditulis admin, tampil di dashboard siswa sampai siswa menekan "Mengerti".
    // Siswa yang profilnya aktif boleh membaca pengumuman yang AKTIF.
    match /announcements/{newsId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && resource.data.active == true);

      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && (request.resource.data.level == 'SEMUA' || isValidLevel(request.resource.data.level))
        && request.resource.data.active is bool;

      allow delete: if isAdmin();
    }

    // ---------- Skor game: gameScores/{id} ----------
    // Disimpan otomatis oleh game-scores.js saat siswa selesai bermain.
    // Hanya siswa yang profilnya masih ada (belum dihapus admin).
    match /gameScores/{scoreId} {
      function myProfile() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }

      // Skor dari paket soal guru (yang dihitung di papan peringkat):
      // paketnya harus ada, aktif, sesuai jenjang siswa, dan jumlah soal
      // harus sama persis dengan isi paket (tidak bisa ditambah-tambah).
      function isValidPackScore() {
        let pack = get(/databases/$(database)/documents/questionPacks/$(request.resource.data.packId)).data;
        return request.resource.data.packId is string
          && pack.active == true
          && (pack.level == 'SEMUA' || pack.level == myProfile().get('level', null))
          && request.resource.data.total == pack.itemCount;
      }

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.correct is int
        && request.resource.data.total is int
        && request.resource.data.total > 0
        && request.resource.data.total <= 1000
        && request.resource.data.correct >= 0
        && request.resource.data.correct <= request.resource.data.total
        // Waktu & minggu diisi apa adanya (tidak bisa dimundurkan/dimajukan)
        && request.resource.data.timestamp == request.time
        && request.resource.data.week is string
        && request.resource.data.week.size() == 10
        // Jenjang di skor harus sama dengan jenjang di profil siswa
        && (!('level' in request.resource.data)
            || request.resource.data.level == myProfile().get('level', null))
        // Skor latihan bebas (tanpa paket) tetap boleh disimpan, tetapi
        // tidak dihitung di papan peringkat.
        && (!('packId' in request.resource.data) || isValidPackScore());

      // Siswa melihat skornya sendiri, dan skor siswa lain (untuk papan
      // peringkat semua jenjang & per jenjang). Admin melihat semua.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)));

      // Skor tidak bisa diubah siswa; admin boleh menghapus.
      allow update, delete: if isAdmin();
    }

    // ---------- Hasil akhir mingguan: weeklyResults/{week} ----------
    // Peringkat minggu yang sudah selesai, dibekukan otomatis saat admin
    // membuka halaman admin. Dipakai untuk rekap minggu lalu & riwayat juara.
    match /weeklyResults/{week} {
      allow read: if isAdmin()
        || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)));
      allow create, update: if isAdmin()
        && request.resource.data.week == week
        && request.resource.data.ranking is list;
      allow delete: if isAdmin();
    }

    // Semua koleksi lain: ditolak (default Firestore).
  }
}
