rules_version = '2';

// =====================================================================
//  Aturan keamanan Firestore - Extra Course (project: extra-course-d02c2)
// ---------------------------------------------------------------------
//  Website ini fokus pada permainan. Data administratif (absensi,
//  pendaftaran lengkap) ada di spreadsheet, bukan di sini.
//
//  Prinsip:
//   - Admin (admin@extracourse.com) boleh membaca & mengubah semua data.
//   - Siswa hanya boleh melihat data MILIKNYA SENDIRI.
//   - Guru (profil role 'Guru', dibuat admin) BUKAN admin. Guru aktif
//     boleh mengelola paket soal MILIKNYA saja. Akses guru hilang begitu
//     admin menonaktifkannya (active false).
//   - Siswa baru wajib memakai kode kelas yang aktif.
//   - Koleksi lain yang tidak disebut di bawah otomatis DITOLAK
//     (termasuk data lama: studentAttendance, registrations, classes, teachers).
//
//  Jika email admin diganti, ubah juga isAdmin() di bawah DAN ADMIN_EMAIL
//  di file ec-common.js.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Fungsi bantu ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'admin@extracourse.com';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---------- Peran (siswa / guru) ----------
    // Profil orang yang sedang login. Panggilan ke dokumen yang sama dalam
    // satu permintaan hanya dihitung sekali baca.
    function myUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return isSignedIn() && exists(myUserPath());
    }

    // Peran di profil. Siswa lama yang tidak punya field role = siswa.
    function myRole() {
      return get(myUserPath()).data.get('role', 'Student');
    }

    // Guru aktif: profil role 'Guru' dan active true. Jika admin
    // menonaktifkan, semua akses guru langsung hilang.
    function isTeacher() {
      return hasProfile()
        && myRole() == 'Guru'
        && get(myUserPath()).data.get('active', false) == true;
    }

    // Profil siswa (bukan guru). Hanya siswa yang boleh menyimpan skor,
    // hewan, dan barang toko.
    function isStudent() {
      return hasProfile() && myRole() != 'Guru';
    }

    // Anggota yang boleh membaca data bersama (paket aktif, pengumuman,
    // skor untuk peringkat, hasil mingguan, hewan): siswa atau guru aktif.
    function isMember() {
      return isStudent() || isTeacher();
    }

    function isValidLevel(level) {
      return level in ['SD', 'SMP', 'SMA', 'S1', 'S2', 'UMUM'];
    }

    // Hewan peliharaan: { species: 'kucing'|'kelinci'|'naga', name: 1-16 huruf }
    function isValidPet(pet) {
      return pet is map
        && pet.keys().hasOnly(['species', 'name'])
        && pet.species in ['kucing', 'kelinci', 'naga']
        && pet.name is string
        && pet.name.size() > 0
        && pet.name.size() <= 16;
    }

    // Toko: items = daftar barang yang dimiliki (maks. 50),
    // equipped = barang yang dipakai per slot, harus termasuk barang miliknya.
    // Catatan: tanpa server, harga & saldo koin dicek di browser siswa
    // (barang hanya tampilan, tidak memengaruhi poin/peringkat).
    function isValidShop(d) {
      return (!('items' in d) || (d.items is list && d.items.size() <= 50))
        && (!('equipped' in d)
            || (d.equipped is map
                && d.equipped.keys().hasOnly(['head', 'face', 'neck', 'bg'])
                && (!('head' in d.equipped) || d.equipped.head in d.items)
                && (!('face' in d.equipped) || d.equipped.face in d.items)
                && (!('neck' in d.equipped) || d.equipped.neck in d.items)
                && (!('bg' in d.equipped) || d.equipped.bg in d.items)));
    }

    // Kode kelas ada, aktif, dan jenjangnya sama dengan yang dipakai siswa.
    function isActiveCodeFor(code, level) {
      let path = /databases/$(database)/documents/classCodes/$(code);
      return code is string
        && exists(path)
        && get(path).data.active == true
        && get(path).data.level == level;
    }

    // ---------- Profil siswa: users/{uid} ----------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Siswa mendaftar sendiri (index.html) dengan kode kelas yang aktif.
      // Akun tanpa email dibuat oleh admin (admin.html).
      allow create: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.keys().hasOnly(['name', 'role', 'email', 'level', 'classCode', 'loginType', 'createdAt'])
            && request.resource.data.role == 'Student'
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.loginType == 'email'
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 80
            && isValidLevel(request.resource.data.level)
            && isActiveCodeFor(request.resource.data.classCode, request.resource.data.level));

      // Siswa hanya boleh memperbarui waktu masuk terakhir, waktu terakhir
      // menekan "Mengerti" di pengumuman (announceSeenAt, harus waktu
      // sekarang), dan hewan peliharaannya (pet: jenis + nama).
      // Nama, jenjang, peran (role), dan status aktif hanya bisa diubah admin.
      // Guru hanya boleh memperbarui waktu masuk terakhir (tanpa hewan/toko).
      allow update: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lastLoginAt', 'announceSeenAt', 'pet', 'items', 'equipped'])
            && (resource.data.get('role', 'Student') != 'Guru'
                || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt']))
            && (!('announceSeenAt' in request.resource.data.diff(resource.data).affectedKeys())
                || request.resource.data.announceSeenAt == request.time)
            && (!('pet' in request.resource.data.diff(resource.data).affectedKeys())
                || isValidPet(request.resource.data.pet))
            && isValidShop(request.resource.data));

      allow delete: if isAdmin();
    }

    // ---------- Kode kelas: classCodes/{code} ----------
    match /classCodes/{code} {
      // Siapa pun boleh mengecek SATU kode yang ia ketahui (untuk form daftar),
      // tetapi tidak boleh melihat daftar semua kode.
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ---------- Paket soal: questionPacks/{id} ----------
    // Bank soal. Dibuat admin (tanpa ownerId) atau guru (ownerId = uid guru).
    // Siswa & guru aktif boleh membaca paket yang AKTIF (game menampilkan
    // paket jenjangnya + "Semua jenjang"). Guru aktif juga boleh membaca
    // semua paket miliknya sendiri (termasuk draf & nonaktif).
    // Batas jenjang ditegakkan saat skor disimpan (lihat isValidPackScore):
    // paket jenjang lain tidak bisa menghasilkan poin.
    //
    // Status paket (lihat packStatus di ec-common.js):
    //   Draf      = draft true, active false, tanpa publishedAt
    //   Nonaktif  = active false (bukan draf)
    //   Terjadwal = active true, publishedAt di masa depan
    //   Terbit    = active true, publishedAt sudah lewat (atau paket lama)
    match /questionPacks/{packId} {
      // Isi paket yang sah (admin maks. 200 soal, guru maks. 30 soal).
      function isValidPack(d, maxItems) {
        return d.title is string
          && d.title.size() > 0
          && d.title.size() <= 80
          && d.type in ['kosakata', 'verb', 'kalimat']
          && (d.level == 'SEMUA' || isValidLevel(d.level))
          && d.active is bool
          // Level paket (opsional untuk paket lama): 1-5
          && (!('tier' in d) || (d.tier is int && d.tier >= 1 && d.tier <= 5))
          && d.items is list
          && d.items.size() > 0
          && d.items.size() <= maxItems
          && d.itemCount == d.items.size()
          // Draf tidak pernah aktif, jadi tidak pernah terlihat siswa
          && (!('draft' in d) || d.draft is bool)
          && !(d.active == true && d.get('draft', false) == true);
      }

      // Bentuk paket guru: hanya field yang dikenal, pemilik = guru itu
      // sendiri, level wajib, maks. 30 soal, draf tanpa tanggal terbit.
      function isValidTeacherPack(d) {
        return d.keys().hasOnly(['title', 'type', 'level', 'tier', 'active', 'draft',
                                 'items', 'itemCount', 'ownerId', 'createdAt', 'updatedAt', 'publishedAt'])
          && d.ownerId == request.auth.uid
          && d.tier is int
          && d.updatedAt == request.time
          && isValidPack(d, 30)
          && (d.get('draft', false) != true || d.get('publishedAt', null) == null);
      }

      // Tanggal terbit dari guru: kosong (draf), sekarang, di masa depan
      // (terjadwal), atau tidak diubah. Tidak bisa dimundurkan, karena
      // Tantangan Harian memakai paket yang terbit sebelum 00.00 hari itu.
      function isValidTeacherPublish(d, old) {
        let p = d.get('publishedAt', null);
        return p == null
          || p == request.time
          || (p is timestamp && p > request.time)
          || (old != null && p == old.get('publishedAt', null));
      }

      allow read: if isAdmin()
        || (isMember() && resource.data.active == true)
        || (isTeacher() && resource.data.ownerId == request.auth.uid);

      allow create: if (isAdmin() && isValidPack(request.resource.data, 200))
        || (isTeacher()
            && isValidTeacherPack(request.resource.data)
            && request.resource.data.createdAt == request.time
            && isValidTeacherPublish(request.resource.data, null));

      // Guru hanya mengubah paket miliknya; pemilik, waktu dibuat, dan
      // jenis soal tidak bisa diganti (agar skor lama tetap masuk akal).
      allow update: if (isAdmin() && isValidPack(request.resource.data, 200))
        || (isTeacher()
            && resource.data.ownerId == request.auth.uid
            && isValidTeacherPack(request.resource.data)
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.type == resource.data.type
            && isValidTeacherPublish(request.resource.data, resource.data));

      // Guru hanya menghapus paket miliknya yang Draf atau Nonaktif
      // (paket Terbit/Terjadwal harus dinonaktifkan dulu). Admin: semua.
      allow delete: if isAdmin()
        || (isTeacher()
            && resource.data.ownerId == request.auth.uid
            && resource.data.active == false);
    }

    // ---------- Pengumuman: announcements/{id} ----------
    // Ditulis admin, tampil di dashboard siswa sampai siswa menekan "Mengerti".
    // Siswa yang profilnya aktif boleh membaca pengumuman yang AKTIF.
    match /announcements/{newsId} {
      allow read: if isAdmin()
        || (isMember() && resource.data.active == true);

      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && (request.resource.data.level == 'SEMUA' || isValidLevel(request.resource.data.level))
        && request.resource.data.active is bool;

      allow delete: if isAdmin();
    }

    // ---------- Skor game: gameScores/{id} ----------
    // Disimpan otomatis oleh game-scores.js saat siswa selesai bermain.
    // Hanya siswa yang profilnya masih ada (belum dihapus admin).
    // Akun guru tidak bisa menyimpan skor (tidak masuk papan peringkat).
    match /gameScores/{scoreId} {
      function myProfile() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }

      // Skor dari paket soal guru (yang dihitung di papan peringkat):
      // paketnya harus ada, aktif, sesuai jenjang siswa, dan jumlah soal
      // harus sama persis dengan isi paket (tidak bisa ditambah-tambah).
      function isValidPackScore() {
        let pack = get(/databases/$(database)/documents/questionPacks/$(request.resource.data.packId)).data;
        return request.resource.data.packId is string
          && pack.active == true
          && (pack.level == 'SEMUA' || pack.level == myProfile().get('level', null))
          && request.resource.data.total == pack.itemCount
          // Paket terjadwal belum bisa dimainkan sebelum waktu terbitnya
          && pack.get('publishedAt', request.time) <= request.time
          // Level paket di skor (dasar bobot poin) harus sama dengan level
          // paket sebenarnya; tanpa packTier dihitung level 1.
          && (!('packTier' in request.resource.data)
              || request.resource.data.packTier == pack.get('tier', 1));
      }

      // Tantangan Harian: sekali per hari. ID dokumen harus
      // harian-<tanggal>-<uid>, jadi menyimpan kedua kali di hari yang sama
      // ditolak (dokumen sudah ada = ubah, hanya admin). Tanggal harus hari
      // ini (WIB), dengan kelonggaran 1 jam lewat tengah malam.
      function isValidDaily(scoreId) {
        let d = request.resource.data;
        let parts = d.daily.split('-');
        let dayStart = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2])) - duration.value(7, 'h');
        return d.daily is string
          && d.daily.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && scoreId == 'harian-' + d.daily + '-' + request.auth.uid
          && d.gameId == 'harian'
          && !('packId' in d)
          && d.total <= 10
          && request.time >= dayStart
          && request.time < dayStart + duration.value(25, 'h');
      }

      allow create: if isStudent()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.correct is int
        && request.resource.data.total is int
        && request.resource.data.total > 0
        && request.resource.data.total <= 1000
        && request.resource.data.correct >= 0
        && request.resource.data.correct <= request.resource.data.total
        // Angka & teks tambahan berjenis benar (ditampilkan di admin & Beranda)
        && request.resource.data.percent is int
        && request.resource.data.percent >= 0
        && request.resource.data.percent <= 100
        && (!('points' in request.resource.data) || request.resource.data.points is int)
        && (!('mode' in request.resource.data)
            || (request.resource.data.mode is string && request.resource.data.mode.size() <= 30))
        // Waktu & minggu diisi apa adanya (tidak bisa dimundurkan/dimajukan)
        && request.resource.data.timestamp == request.time
        && request.resource.data.week is string
        && request.resource.data.week.size() == 10
        // Jenjang di skor harus sama dengan jenjang di profil siswa
        && (!('level' in request.resource.data)
            || request.resource.data.level == myProfile().get('level', null))
        // Skor latihan bebas (tanpa paket) tetap boleh disimpan, tetapi
        // tidak dihitung di papan peringkat.
        && (!('packId' in request.resource.data) || isValidPackScore())
        && (!('daily' in request.resource.data) || isValidDaily(scoreId));

      // Siswa melihat skornya sendiri, dan skor siswa lain (untuk papan
      // peringkat semua jenjang & per jenjang). Admin melihat semua.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || isMember();

      // Skor tidak bisa diubah siswa; admin boleh menghapus.
      allow update, delete: if isAdmin();
    }

    // ---------- Hasil akhir mingguan: weeklyResults/{week} ----------
    // Peringkat minggu yang sudah selesai, dibekukan otomatis saat admin
    // membuka halaman admin. Dipakai untuk rekap minggu lalu & riwayat juara.
    match /weeklyResults/{week} {
      allow read: if isAdmin() || isMember();
      allow create, update: if isAdmin()
        && request.resource.data.week == week
        && request.resource.data.ranking is list;
      allow delete: if isAdmin();
    }

    // ---------- Hewan untuk ditampilkan ke siswa lain: pets/{uid} ----------
    // Salinan publik hewan siswa (jenis, nama, barang dipakai) untuk papan
    // peringkat & poster. Ditulis oleh pemiliknya sendiri (siswa, bukan guru).
    match /pets/{uid} {
      allow read: if isAdmin() || isMember();
      allow create, update: if isOwner(uid)
        && isStudent()
        && request.resource.data.keys().hasOnly(['species', 'name', 'equipped'])
        && request.resource.data.species in ['kucing', 'kelinci', 'naga']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 16
        && (!('equipped' in request.resource.data)
            || (request.resource.data.equipped is map
                && request.resource.data.equipped.keys().hasOnly(['head', 'face', 'neck', 'bg'])));
      allow delete: if isAdmin() || isOwner(uid);
    }

    // Semua koleksi lain: ditolak (default Firestore).
  }
}
